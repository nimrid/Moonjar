{
  "name": "moonjar-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --parallel --filter @moonjar/web --filter @moonjar/keeper run dev",
    "dev:web": "pnpm --filter @moonjar/web dev",
    "dev:keeper": "pnpm --filter @moonjar/keeper dev",
    "start": "pnpm --parallel --filter @moonjar/web --filter @moonjar/keeper run start",
    "test": "pnpm --recursive run test",
    "test:spike": "tsx scripts/spike.ts",
    "init-cluster": "tsx scripts/init-cluster.ts",
    "fund": "tsx scripts/fund.ts",
    "lint": "pnpm --recursive run lint"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.8",
    "@types/chai": "^4.3.5",
    "@types/mocha": "^10.0.1",
    "@types/node": "^22.10.2",
    "chai": "^4.3.7",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
